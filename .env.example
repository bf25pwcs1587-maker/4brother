# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
SESSION_SECRET="replace-with-a-random-32-character-secret-in-production"

# Supabase Deployment (Optional - for direct Supabase Auth & PostgreSQL sync)
# Public Browser Anon Key ONLY. Never expose service_role or DB password in frontend.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-with-row-level-security-enabled"

